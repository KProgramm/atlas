generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  clerkId      String        @unique
  name         String?
  email        String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userProblems UserProblem[]
}

model Problem {
  id           String        @id @default(cuid())
  leetcodeId   Int?          @unique
  title        String
  difficulty   String
  pattern      String?
  tags         String[]
  url          String?
  source       String        @default("manual")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userProblems UserProblem[]
}

model UserProblem {
  id             String          @id @default(cuid())
  userId         String
  problemId      String
  solvedAt       DateTime?
  importedAt     DateTime        @default(now())
  source         String          @default("manual")
  originalCode   String?
  originalNotes  String?
  lastReviewedAt DateTime?
  nextReviewAt   DateTime?
  reviewStage    Int             @default(0)
  masteryScore   Float           @default(0)
  totalReviews   Int             @default(0)
  status         String          @default("active")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id])
  problem        Problem         @relation(fields: [problemId], references: [id])
  reviewSessions ReviewSession[]
}

model ReviewSession {
  id                 String      @id @default(cuid())
  userProblemId      String
  startedAt          DateTime    @default(now())
  completedAt        DateTime?
  recognitionScore   Float?
  approachScore      Float?
  complexityScore    Float?
  adaptabilityScore  Float?
  communicationScore Float?
  overallConfidence  Float?
  aiModel            String?
  promptVersion      String?
  createdAt          DateTime    @default(now())
  userProblem        UserProblem @relation(fields: [userProblemId], references: [id])
  questions          Question[]
}

model Question {
  id              String        @id @default(cuid())
  reviewSessionId String
  type            String
  prompt          String
  expectedAnswer  String?
  userAnswer      String?
  aiScore         Float?
  aiFeedback      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  reviewSession   ReviewSession @relation(fields: [reviewSessionId], references: [id])
}
